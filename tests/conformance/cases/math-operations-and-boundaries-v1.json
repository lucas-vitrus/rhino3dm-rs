{
  "schema": "rhino3dm-rs.conformance-case.v1",
  "case_id": "math.operations-and-boundaries.v1",
  "comparison": {
    "numeric": {
      "atol": 1e-12,
      "rtol": 1e-12,
      "rationale": "Computed double-precision operations. Point/vector source values and sentinel behavior are observed exactly outside ordinary floating arithmetic."
    }
  },
  "operations": [
    {"id": "point", "call": "point3d.new", "args": [2.0, 3.0, 5.0]},
    {"id": "other_point", "call": "point3d.new", "args": [7.0, 11.0, 13.0]},
    {"id": "vector", "call": "vector3d.new", "args": [3.0, 4.0, 0.0]},
    {"id": "other_vector", "call": "vector3d.new", "args": [-4.0, 3.0, 0.0]},
    {"id": "negative_vector", "call": "vector3d.new", "args": [-3.0, -4.0, 0.0]},
    {"id": "near_vector", "call": "vector3d.new", "args": [3.0, 4.0, 0.001]},
    {"id": "zero_vector", "call": "vector3d.new", "args": [0.0, 0.0, 0.0]},
    {"id": "point_plus_point", "call": "point3d.add_point", "receiver": "point", "args": [{"ref": "other_point"}]},
    {"id": "point_plus_vector", "call": "point3d.add_vector", "receiver": "point", "args": [{"ref": "vector"}]},
    {"id": "point_scaled", "call": "point3d.scale", "receiver": "point", "args": [2.0]},
    {"id": "dot", "call": "vector3d.dot_product", "args": [{"ref": "vector"}, {"ref": "other_vector"}]},
    {"id": "cross", "call": "vector3d.cross_product", "args": [{"ref": "vector"}, {"ref": "other_vector"}]},
    {"id": "parallel", "call": "vector3d.is_parallel_to", "receiver": "vector", "args": [{"ref": "vector"}]},
    {"id": "antiparallel", "call": "vector3d.is_parallel_to", "receiver": "vector", "args": [{"ref": "negative_vector"}]},
    {"id": "zero_parallel", "call": "vector3d.is_parallel_to", "receiver": "vector", "args": [{"ref": "zero_vector"}]},
    {"id": "near_default_parallel", "call": "vector3d.is_parallel_to", "receiver": "vector", "args": [{"ref": "near_vector"}]},
    {"id": "near_strict_parallel", "call": "vector3d.is_parallel_to", "receiver": "vector", "args": [{"ref": "near_vector"}, 0.0001]},
    {"id": "right_angle", "call": "vector3d.vector_angle", "receiver": "vector", "args": [{"ref": "other_vector"}]},
    {"id": "zero_angle", "call": "vector3d.vector_angle", "receiver": "vector", "args": [{"ref": "zero_vector"}]},
    {"id": "identity", "call": "transform.identity", "args": []},
    {"id": "zero_transform", "call": "transform.zero_transformation", "args": []},
    {"id": "unset_transform", "call": "transform.unset", "args": []},
    {"id": "translation", "call": "transform.translation", "args": [7.0, 11.0, 13.0]},
    {"id": "rotation_axis", "call": "vector3d.new", "args": [0.0, 0.0, 1.0]},
    {"id": "origin", "call": "point3d.new", "args": [0.0, 0.0, 0.0]},
    {"id": "quarter_turn", "call": "transform.rotation_axis_angle", "args": [1.5707963267948966, {"ref": "rotation_axis"}, {"ref": "origin"}]},
    {"id": "rotated_point", "call": "point3d.transform", "receiver": "point", "args": [{"ref": "quarter_turn"}]},
    {"id": "transposed_translation", "call": "transform.transpose", "receiver": "translation", "args": []},
    {"id": "translation_row_major", "call": "transform.to_float_array", "receiver": "translation", "args": [true]},
    {"id": "translation_column_major", "call": "transform.to_float_array", "receiver": "translation", "args": [false]}
  ],
  "observe": [
    "point_plus_point",
    "point_plus_vector",
    "point_scaled",
    "dot",
    "cross",
    "parallel",
    "antiparallel",
    "zero_parallel",
    "near_default_parallel",
    "near_strict_parallel",
    "right_angle",
    "zero_angle",
    "identity",
    "zero_transform",
    "unset_transform",
    "quarter_turn",
    "rotated_point",
    "transposed_translation",
    "translation_row_major",
    "translation_column_major"
  ]
}
