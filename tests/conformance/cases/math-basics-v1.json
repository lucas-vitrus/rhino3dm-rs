    {"id": "scale_then_translation", "call": "transform.multiply", "args": [{"ref": "scale"}, {"ref": "translation"}]},
    {"id": "first_order_point", "call": "point3d.transform", "receiver": "point", "args": [{"ref": "translation_then_scale"}]},
