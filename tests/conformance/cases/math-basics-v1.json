    {"id": "distance", "call": "point3d.distance_to", "receiver": "point", "args": [{"ref": "other"}]},
    {"id": "translation", "call": "transform.translation", "args": [7.0, 11.0, 13.0]},
    {"id": "translated", "call": "point3d.transform", "receiver": "point", "args": [{"ref": "translation"}]},
    {"id": "scale", "call": "transform.diagonal", "args": [2.0]},
