    {"id": "vector_length_after", "call": "vector3d.length", "receiver": "vector"},
    {"id": "translation_from_vector", "call": "transform.translation", "args": [{"ref": "vector"}]},
    {"id": "zero", "call": "transform.diagonal", "args": [0.0]},
    {"id": "zero_inverse", "call": "transform.try_get_inverse", "receiver": "zero"}
